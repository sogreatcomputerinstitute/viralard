# Local environment variables. Never commit real keys.
GEMINI_API_KEY=

# Phase 2 - Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CREDITS_50=
# Phase 4 - Pro activation (temporary, replaced by Stripe Checkout)
# Comma separated. Only SHA-256 digests are compared, in constant time.
PRO_ACTIVATION_CODES=

# Phase 5 - SEO + analytics
NEXT_PUBLIC_SITE_URL=https://viralard.vercel.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Phase 5 - Supabase keepalive cron
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on scheduled hits.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Monetag. Off by default. Note: tag.min.js is a POPUNDER, which interrupts the
# analyze flow. Prefer a banner or rail if the numbers hold up.
MONETAG_ENABLED=false
MONETAG_ZONE_ID=

# First-party ad slots. These render from our own HTML, so blockers cannot
# remove them. Point AD_SPONSOR_HREF at a direct-sold sponsor when you have one;
# with nothing set the slots show a house ad for Viralard Pro.
AD_SPONSOR_IMAGE_URL=
AD_SPONSOR_HREF=
